      "Bash(composer require *)",
      "Bash(composer run *)",
      "Bash(composer show*)",
      "Bash(composer validate*)",
      "Bash(cp *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(docker compose exec *)",
      "Bash(docker compose logs*)",
      "Bash(docker compose ps*)",
      "Bash(docker ps*)",
      "Bash(docker-compose exec *)",
      "Bash(docker-compose logs*)",
      "Bash(docker-compose ps*)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(gh api *)",
      "Bash(gh issue *)",
      "Bash(gh pr diff*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(git add *)",
      "Bash(git blame*)",
      "Bash(git branch --list*)",
      "Bash(git branch)",
      "Bash(git checkout -b *)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git stash*)",
      "Bash(git status*)",
      "Bash(git switch *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(mysql * -e *)",
      "Bash(node *)",
      "Bash(npm ci)",
      "Bash(npm install*)",
      "Bash(npm ls*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx *)",
      "Bash(npx gsd-core *)",
      "Bash(php -l *)",
      "Bash(php -r *)",
      "Bash(php -v)",
      "Bash(php bin/console *)",
      "Bash(php vendor/bin/*)",
      "Bash(pnpm *)",
      "Bash(printf *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(sed -n *)",
      "Bash(sort *)",
      "Bash(symfony console *)",
      "Bash(tail *)",
      "Bash(touch *)",
      "Bash(uniq *)",
      "Bash(vendor/bin/*)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(wp *)",
      "Bash(yarn *)",
      "Edit",
      "Edit(.planning/*)",
      "Edit(STATE.md)",
      "Read(.planning/*)",
      "Read(STATE.md)",
      "Write"
    ],
    "deny": [
      "Bash(* doctrine:database:drop*)",
      "Bash(* doctrine:fixtures:load*)",
      "Bash(* doctrine:schema:drop*)",
      "Bash(* doctrine:schema:update --force*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git clean *)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git restore .*)",
      "Bash(mysql * ALTER *)",
      "Bash(mysql * DELETE *)",
      "Bash(mysql * DROP *)",
      "Bash(mysql * TRUNCATE *)",
      "Bash(mysqladmin drop*)",
      "Bash(npm audit fix*)",
      "Bash(rm -rf .*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(wp db drop*)",
      "Bash(wp db import*)",
      "Bash(wp db reset*)",
      "Read(./**/*.log)",
      "Read(./**/*.sql.gz)",
      "Read(./**/*.sql.xz)",
      "Read(./**/.env.local)",
      "Read(./.cache/**)",
      "Read(./.env.*.local)",
      "Read(./.env.local)",
      "Read(./storage/logs/**)",
      "Read(./symfony.log)",
      "Read(./var/log/**)",
      "Read(./var/logs/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(* doctrine:migrations:execute*)",
      "Bash(* doctrine:migrations:migrate*)",
      "Bash(composer update*)",
      "Bash(docker compose down*)",
      "Bash(docker compose up*)",
      "Bash(docker-compose down*)",
      "Bash(docker-compose up*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(rm -r*)"
    ],
    "defaultMode": "acceptEdits",
    "blockReadsOutsideWorkingDirectories": false
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "lf@lefebvriano-holder": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "api.github.com",
        "codeload.github.com",
        "github.com",
        "objects.githubusercontent.com",
        "packagist.org",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "repo.packagist.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.bun",
        "~/.cache",
        "~/.config/composer",
        "~/.npm"
      ]
    },
    "enableWeakerNestedSandbox": true
  },
  "autoCompactWindow": 200000
}