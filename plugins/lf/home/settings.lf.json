{
  "model": "claude-sonnet-5-5",
  "outputStyle": "Concise",
  "modelSettings": {
    "claude-sonnet-5-5": { "effortLevel": "medium" },
    "claude-opus-5-5": { "effortLevel": "medium" }
  },
  "idleCompaction": false,
  "language": "Spanish",
  "includeGitInstructions": false,
  "awaySummaryEnabled": false,
  "skillListingMaxDescChars": 150,
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_GOAL_CHECKIN_MINUTES": "0",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-5-5",
    "DISABLE_TELEMETRY": "1",
    "FORCE_AUTOUPDATE_PLUGINS": "1"
  },
  "extraKnownMarketplaces": {
    "lefebvriano-holder": {
      "source": {
        "source": "github",
        "repo": "Lf-SergioDominguez/lf-holder"
      },
      "autoUpdate": true
    },
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      },
      "autoUpdate": true
    }
  },
  "permissions": {
    "allow": [
      "Bash(awk *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(composer outdated*)",
      "Bash(composer show*)",
      "Bash(composer validate*)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(docker compose exec *)",
      "Bash(docker compose logs*)",
      "Bash(docker compose ps*)",
      "Bash(docker exec *)",
      "Bash(docker ps*)",
      "Bash(docker-compose exec *)",
      "Bash(docker-compose logs*)",
      "Bash(docker-compose ps*)",
      "Bash(echo *)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(git add *)",
      "Bash(git blame*)",
      "Bash(git branch --list*)",
      "Bash(git branch)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git status*)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(mariadb * -e *)",
      "Bash(mysql * -e *)",
      "Bash(npx -y modern-web-guidance@latest legacy-scan *)",
      "Bash(npx -y modern-web-guidance@latest list*)",
      "Bash(npx -y modern-web-guidance@latest retrieve *)",
      "Bash(npx -y modern-web-guidance@latest search *)",
      "Bash(php -l *)",
      "Bash(php -v)",
      "Bash(pnpx modern-web-guidance@latest legacy-scan *)",
      "Bash(pnpx modern-web-guidance@latest list*)",
      "Bash(pnpx modern-web-guidance@latest retrieve *)",
      "Bash(pnpx modern-web-guidance@latest search *)",
      "Bash(printf *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(sed -n *)",
      "Bash(sort *)",
      "Bash(tail *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Edit",
      "Edit(.planning/*)",
      "Edit(STATE.md)",
    "Edit(~/.claude/lf/memory/**)",
      "Read(.planning/*)",
      "Read(STATE.md)",
      "Write"
    ],
    "deny": [
      "Bash(* doctrine:database:drop*)",
      "Bash(* doctrine:fixtures:load*)",
      "Bash(* doctrine:schema:drop*)",
      "Bash(* doctrine:schema:update --force*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker system prune*)",
      "Bash(docker volume prune*)",
      "Bash(docker volume rm*)",
      "Bash(docker-compose down -v*)",
      "Bash(docker-compose down --volumes*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git clean *)",
      "Bash(git commit --amend*)",
      "Bash(git push --delete*)",
      "Bash(git push --force*)",
      "Bash(git push --mirror*)",
      "Bash(git push -f*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git restore .*)",
      "Bash(mariadb * ALTER *)",
      "Bash(mariadb * DELETE *)",
      "Bash(mariadb * DROP *)",
      "Bash(mariadb * TRUNCATE *)",
      "Bash(mysql * ALTER *)",
      "Bash(mysql * DELETE *)",
      "Bash(mysql * DROP *)",
      "Bash(mysql * TRUNCATE *)",
      "Bash(mysqladmin drop*)",
      "Bash(npm audit fix*)",
      "Bash(rm -rf .*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(wp db drop*)",
      "Bash(wp db import*)",
      "Bash(wp db reset*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(docker compose down*)",
      "Bash(docker compose run*)",
      "Bash(docker compose up*)",
      "Bash(docker run*)",
      "Bash(docker-compose down*)",
      "Bash(docker-compose run*)",
      "Bash(docker-compose up*)",
      "Bash(git commit*)",
      "Bash(rm *)"
    ],
    "defaultMode": "acceptEdits",
    "blockReadsOutsideWorkingDirectories": false
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "lf@lefebvriano-holder": true,
    "modern-web-guidance@googlechrome": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "curl *127.0.0.1*",
      "curl *localhost*",
      "docker *",
      "docker-compose *",
      "gh *",
      "git clone *",
      "git fetch*",
      "git ls-remote*",
      "git pull*",
      "git push*",
      "mariadb *",
      "mysql *",
      "mysqladmin *"
    ],
    "network": {
      "allowedDomains": [
        "api.github.com",
        "codeload.github.com",
        "github.com",
        "objects.githubusercontent.com",
        "packagist.org",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "repo.packagist.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.bun",
        "~/.cache",
        "~/.config/composer",
        "~/.npm"
      ]
    },
    "enableWeakerNestedSandbox": true
  },
  "autoCompactWindow": 253000,
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/lf/statusline.sh\""
  }
}
